{
  "name": "structa",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/app",
    "packages/backend",
    "packages/core",
    "packages/functions",
    "packages/notifications",
    "packages/scripts"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.js --disableConsoleIntercept",
    "typecheck": "npm run typecheck:core && npm run typecheck:backend && npm run typecheck:app",
    "typecheck:core": "cd packages/core && npm run typecheck",
    "typecheck:backend": "cd packages/backend && npm run typecheck",
    "typecheck:app": "cd packages/app && npm run typecheck",
    "dev:email": "npm run dev --workspace=@structa/notifications"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tanstack/devtools": "^0.7.0",
    "@tsconfig/node22": "^22",
    "@types/node": "^25.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "hono": "^4.10.4",
    "sst": "^3.17.25",
    "stripe": "^18.1.1",
    "zod": "^3.24.1"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
